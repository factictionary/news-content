    {
      "id": "004",
      "headline": "Chuckles McGee Laughs So Hard At Own Joke That He Forgets Punchline, Starts Over",
      "summary": "The comedy show has been running for 47 minutes on the same joke.",
      "fullBody": "Chuckles McGee, the self-proclaimed 'funniest man in Chuckleton,' performed a 90-minute set that consisted entirely of one joke—because he kept laughing so hard at the setup that he forgot the punchline. 'It's a new style of comedy called 'anticipatory hilarity,'' McGee explained. The audience was reportedly 'confused but charmed.' One attendee said, 'I think I laughed eventually, but I'm not sure why.' McGee plans to release a Netflix special titled 'I'll Get There Eventually.'",
      "category": "entertainment",
      "imageUrl": "https://raw.githubusercontent.com/factictionary/news-content/main/images/2026-06-09/004.jpg",
      "publishedAt": "9 hrs ago",
      "readTimeSeconds": 74,
      "tags": ["Comedy", "Satire", "Entertainment"],
      "isBreaking": false
    },
    {
      "id": "005",
      "headline": "Professor Wobblepants Discovers That Water Is Wet, Publishes 200-Page Study",
      "summary": "The study cost $2 million in research grants to confirm what everyone already knew.",
      "fullBody": "Professor Percival Wobblepants of the University of Obvious Findings has published a groundbreaking 200-page study confirming that water is, in fact, wet. The study, funded by a $2 million grant, involved 47 experiments, 12 research assistants, and one very damp laboratory. 'The results were surprising,' Wobblepants admitted. When asked if the research was necessary, he replied, 'Science is never unnecessary. Now if you'll excuse me, I have a grant proposal on whether the sky is blue.'",
      "category": "science",
      "imageUrl": "https://raw.githubusercontent.com/factictionary/news-content/main/images/2026-06-09/005.jpg",
      "publishedAt": "11 hrs ago",
      "readTimeSeconds": 66,
      "tags": ["Science", "Satire", "Research"],
      "isBreaking": false
